generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["nativeDistinct", "relationJoins"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["film"]
}

model Cover {
  id          Int    @id @default(autoincrement())
  info        String
  contentType String  @map("contenttype")
  filmId      Int @map("film_id")
  film        Film   @relation(fields: [filmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([filmId])
  @@map("cover")
  @@schema("film")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Film {
  id                Int         @id @default(autoincrement())
  version           Int         @default(0)
  titel             String
  art               Filmart?
  erscheinungsdatum DateTime    @db.Date
  genre             Genres
  rating            Decimal     @db.Decimal(3, 1)
  verfuegbar        Boolean     @default(false)
  preis             Decimal     @db.Decimal(5, 2)
  schlagwoerter     Json?
  erzeugt           DateTime    @default(now()) @db.Timestamp(6)
  aktualisiert      DateTime    @default(now()) @db.Timestamp(6)  @updatedAt
  cover             Cover[]
  filmFile          FilmFile?
  regisseur         Regisseur?

  @@map("film")
  @@schema("film")
}

model FilmFile {
  id       Int     @id @default(autoincrement())
  data     Bytes
  filename String
  mimetype String?
  filmId   Int     @unique @map("film_id")
  film     Film    @relation(fields: [filmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([filmId])
  @@map("film_file")
  @@schema("film")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Regisseur {
  id          Int    @id @default(autoincrement())
  name        String
  geburtsjahr Int?
  filmId      Int    @unique  @map("film_id")
  film        Film   @relation(fields: [filmId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([filmId])
  @@map("regisseur")
  @@schema("film")
}

enum Filmart {
  DVD
  BlueRay
  K       @map("4K")

  @@map("filmart")
  @@schema("film")
}

enum Genres {
  Action
  Drama
  Thriller
  Musical
  ScienceFiction
  Biografie

  @@map("genres")
  @@schema("film")
}
